# Рабочие документы: стратегия, разбор конкурентов, планы по цене, чек-лист
# незавершённого. Репозиторий публичный — эти файлы остаются только на диске.
PROJECT.md
docs/

# тестовые архивы — генерируются локально, на сайт выкладывать не нужно
site/_test/

# python
__pycache__/
*.pyc

# артефакты старого десктопного приложения
runs.json
animation.html

# Закрытый ключ выдачи покупок — в репозиторий не попадает никогда
wayback-private-key.json
*private-key*.json

# Зависимости облачной функции — ставятся через npm install, в репозиторий не идут
functions/*/node_modules/

# Архив для загрузки в Yandex Cloud Functions — собирается локально, не в репозиторий
functions/*/*.zip

# Собранный архив функции — делается скриптом, в репозиторий не идёт
build/
