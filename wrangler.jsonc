{
  // Конфиг для Cloudflare. Нужен потому, что Cloudflare убрал создание
  // Pages-проектов из интерфейса и новые статические сайты разворачиваются
  // через Workers. Скрипта у нас нет — только папка со статикой, поэтому
  // поле "main" отсутствует: Worker работает в режиме раздачи файлов.
  "name": "wayback",
  "compatibility_date": "2026-08-23",
  "assets": {
    // Всё, что выкладывается в интернет. Остальное (tools, docs, legacy)
    // лежит в репозитории, но наружу не отдаётся.
    "directory": "./site"
  }
}
